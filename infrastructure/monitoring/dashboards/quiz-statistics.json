  {
   "id": 15,
   "type": "timeseries",
   "title": "Weekly leaderboard response time",
   "description": "GET /api/statistics/weekly. p95 solid, p50 dashed. With the cache this should stay flat however many games the week has.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_deployment_name=\"statisticservice\",http_route=~\".*weekly.*\"}[$__rate_interval])))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_deployment_name=\"statisticservice\",http_route=~\".*weekly.*\"}[$__rate_interval])))",
     "legendFormat": "p50"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineInterpolation": "smooth",
      "fillOpacity": 15,
      "showPoints": "never"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "p50"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
