{
  "uid": "quiz-overview",
  "title": "Quiz overview",
  "description": "The namespace quiz: Redis cache, pods, requests and logs. The data sources of this org only return the namespace quiz.",
  "tags": ["quiz"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "editable": false,
  "templating": { "list": [] },
  "panels": [
    { "type": "row", "title": "Lobbies", "id": 41, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    { "type": "stat", "title": "Active lobbies", "id": 40,
      "description": "Waiting and started lobbies right now (LobbyService, slopster_lobbies_active). The link opens the Slopster Lobbies dashboard.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "links": [{ "title": "Slopster Lobbies", "url": "/d/quiz-lobbies" }],
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (status) (slopster_lobbies_active)", "legendFormat": "{{status}}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "timeseries", "title": "Active lobbies", "id": 42,
      "description": "Waiting and started lobbies over time, stacked.",
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 1 },
      "links": [{ "title": "Slopster Lobbies", "url": "/d/quiz-lobbies" }],
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (status) (slopster_lobbies_active)", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0,
        "custom": { "fillOpacity": 15, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } } } } },
    { "type": "row", "title": "Cache (Redis)", "id": 1, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 } },
    { "type": "stat", "title": "Redis up", "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "max(redis_up)" }],
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "stat", "title": "Hit rate (5m)", "id": 3,
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(redis_keyspace_hits_total[5m])) / (sum(rate(redis_keyspace_hits_total[5m])) + sum(rate(redis_keyspace_misses_total[5m])))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "green", "value": 0.8 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "stat", "title": "Keys", "id": 4,
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(redis_db_keys)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "stat", "title": "Connected clients", "id": 5,
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(redis_connected_clients)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "stat", "title": "Memory used", "id": 6,
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(redis_memory_used_bytes)" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "timeseries", "title": "Hits and misses /s", "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(redis_keyspace_hits_total[$__rate_interval]))", "legendFormat": "hits" },
        { "refId": "B", "expr": "sum(rate(redis_keyspace_misses_total[$__rate_interval]))", "legendFormat": "misses" }],
      "fieldConfig": { "defaults": { "unit": "ops" } } },
    { "type": "timeseries", "title": "Commands /s by command", "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "topk(10, sum by (cmd) (rate(redis_commands_total[$__rate_interval])))", "legendFormat": "{{cmd}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" } } },
    { "type": "timeseries", "title": "Memory and evictions", "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(redis_memory_used_bytes)", "legendFormat": "used" },
        { "refId": "B", "expr": "sum(rate(redis_evicted_keys_total[$__rate_interval]))", "legendFormat": "evicted keys /s" },
        { "refId": "C", "expr": "sum(rate(redis_expired_keys_total[$__rate_interval]))", "legendFormat": "expired keys /s" }],
      "fieldConfig": { "defaults": { "unit": "bytes" },
        "overrides": [{ "matcher": { "id": "byRegexp", "options": ".*/s" },
          "properties": [{ "id": "unit", "value": "ops" }, { "id": "custom.axisPlacement", "value": "right" }] }] } },
    { "type": "timeseries", "title": "Keys and clients", "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (db) (redis_db_keys)", "legendFormat": "keys {{db}}" },
        { "refId": "B", "expr": "sum(redis_connected_clients)", "legendFormat": "clients" }] },

    { "type": "row", "title": "Services", "id": 20, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 } },
    { "type": "timeseries", "title": "HTTP requests /s by service (OTLP)", "id": 21,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "type": "timeseries", "title": "HTTP p95 latency by service (OTLP)", "id": 22,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } } },
    { "type": "timeseries", "title": "CPU by pod", "id": 23,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container!=\"\"}[$__rate_interval]))", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "cores" } } },
    { "type": "timeseries", "title": "Memory by pod", "id": 24,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{container!=\"\"})", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } } },
    { "type": "table", "title": "Restarts (last 24h)", "id": 25,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total[24h])) > 0", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "restarts" } } }] },

    { "type": "row", "title": "Logs", "id": 30, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 } },
    { "type": "timeseries", "title": "Log lines by service", "id": 31,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 45 },
      "datasource": { "type": "loki", "uid": "quiz-loki" },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (count_over_time({service_name=~\".+\"}[$__auto]))", "legendFormat": "{{service_name}}" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } } },
    { "type": "logs", "title": "Logs", "id": 32,
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 51 },
      "datasource": { "type": "loki", "uid": "quiz-loki" },
      "targets": [{ "refId": "A", "expr": "{service_name=~\".+\"}" }],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true, "wrapLogMessage": true } }
  ]
}
