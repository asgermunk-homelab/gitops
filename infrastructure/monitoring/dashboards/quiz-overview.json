{
  "uid": "quiz-overview",
  "title": "Quiz overview",
  "description": "The namespace quiz: lobbies, games, Redis cache, pods, requests, service counters, traces and logs. The data sources of this org only return the namespace quiz.",
  "tags": ["quiz"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "editable": false,
  "templating": { "list": [] },
  "links": [{ "title": "Explore traces (Tempo)", "type": "link", "icon": "external link", "targetBlank": true,
    "url": "/explore?left=%7B%22datasource%22:%22quiz-tempo%22,%22queries%22:%5B%7B%22refId%22:%22A%22,%22queryType%22:%22traceqlSearch%22%7D%5D%7D" }],
  "panels": [
    { "type": "row", "title": "Lobbies", "id": 41, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    { "type": "stat", "title": "Active lobbies", "id": 40,
      "description": "Waiting and started lobbies right now (LobbyService, slopster_lobbies_active). The link opens the Slopster Lobbies dashboard.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "links": [{ "title": "Slopster Lobbies", "url": "/d/quiz-lobbies" }],
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (status) (slopster_lobbies_active)", "legendFormat": "{{status}}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "timeseries", "title": "Active lobbies", "id": 42,
      "description": "Waiting and started lobbies over time, stacked.",
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 1 },
      "links": [{ "title": "Slopster Lobbies", "url": "/d/quiz-lobbies" }],
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (status) (slopster_lobbies_active)", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0,
        "custom": { "fillOpacity": 15, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } } } } },
    { "type": "row", "title": "Games", "id": 51, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 } },
    { "type": "stat", "title": "Active games", "id": 50,
      "description": "Games being played right now (GameService, slopster_games_active; every pod reports the same total, so max). The link opens the Slopster Games dashboard.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 7 },
      "links": [{ "title": "Slopster Games", "url": "/d/quiz-games" }],
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "max(slopster_games_active)", "legendFormat": "active games", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "timeseries", "title": "Active games", "id": 52,
      "description": "Games being played over time.",
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 7 },
      "links": [{ "title": "Slopster Games", "url": "/d/quiz-games" }],
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "max(slopster_games_active)", "legendFormat": "active games" }],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0,
        "custom": { "fillOpacity": 15, "showPoints": "never" } } } },
    { "type": "row", "title": "Cache (Redis)", "id": 1, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 } },
    { "type": "stat", "title": "Redis up", "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "max(redis_up)" }],
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "stat", "title": "Lobby cache hit rate (5m)", "id": 3,
      "description": "How often LobbyService finds a lobby in its Redis cache (slopster_lobby_cache_lookups_total, SCRUM-118). Not Redis' own keyspace hit rate: Redis also holds GameService's games and the SignalR backplanes (ADR-0004), whose reads are not cache lookups.",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(slopster_lobby_cache_lookups_total{result=\"hit\"}[5m])) / sum(rate(slopster_lobby_cache_lookups_total[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 1, "noValue": "no lookups",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "green", "value": 0.8 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "stat", "title": "Keys", "id": 4,
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(redis_db_keys)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "stat", "title": "Connected clients", "id": 5,
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(redis_connected_clients)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "stat", "title": "Memory used", "id": 6,
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(redis_memory_used_bytes)" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "type": "timeseries", "title": "Lobby cache lookups /s", "id": 7,
      "description": "LobbyService's cache lookups by result (hit or miss). Redis' own reads, including GameService's deadline polling, are under Commands /s.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(slopster_lobby_cache_lookups_total[$__rate_interval]))", "legendFormat": "{{result}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" } } },
    { "type": "timeseries", "title": "Memory and evictions", "id": 9,
      "description": "Left axis: memory Redis uses. Right axis: keys Redis removes per second. Expired = a key whose time to live ran out (lobby cache entries, game locks); that is normal and follows the traffic. Evicted = Redis was full (maxmemory) and threw a key away early; that should stay 0, and if it does not, Redis needs more memory.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(redis_memory_used_bytes)", "legendFormat": "memory used" },
        { "refId": "B", "expr": "sum(rate(redis_evicted_keys_total[$__rate_interval]))", "legendFormat": "evicted (full) /s" },
        { "refId": "C", "expr": "sum(rate(redis_expired_keys_total[$__rate_interval]))", "legendFormat": "expired (TTL) /s" }],
      "fieldConfig": { "defaults": { "unit": "bytes" },
        "overrides": [{ "matcher": { "id": "byRegexp", "options": ".*/s" },
          "properties": [{ "id": "unit", "value": "ops" }, { "id": "custom.axisPlacement", "value": "right" }] }] } },
    { "type": "row", "title": "Services", "id": 20, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 } },
    { "type": "timeseries", "title": "HTTP requests /s by service (OTLP)", "id": 21,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "type": "timeseries", "title": "HTTP latency by service: p95 (solid) and p50 (dashed)", "id": 22,
      "description": "p95: 95% of requests were faster than this, so it shows the slow tail. p50 (dashed): the median, a typical request. A p95 far above the p50 means a few requests are slow.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{job}} p95" },
        { "refId": "B", "expr": "histogram_quantile(0.5, sum by (job, le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{job}} p50" }],
      "fieldConfig": { "defaults": { "unit": "s" },
        "overrides": [{ "matcher": { "id": "byRegexp", "options": ".* p50" },
          "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } }] }] } },
    { "type": "timeseries", "title": "CPU by pod", "id": 23,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container!=\"\"}[$__rate_interval]))", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "cores" } } },
    { "type": "timeseries", "title": "Memory by pod", "id": 24,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{container!=\"\"})", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } } },
    { "type": "table", "title": "Restarts (last 24h)", "id": 25,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total[24h])) > 0", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "restarts" } } }] },
    { "type": "timeseries", "title": "HTTP error rate by service (5xx share)", "id": 26,
      "description": "Share of HTTP requests answered with 5xx, per service (OTLP, SCRUM-173).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) / sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 10 } } } },
    { "type": "timeseries", "title": "Edge: rejected by rate limit /s", "id": 27,
      "description": "Requests EdgeService turned away with 429 (per-ip policy, Microsoft.AspNetCore.RateLimiting).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (aspnetcore_rate_limiting_result) (rate(aspnetcore_rate_limiting_requests_total{aspnetcore_rate_limiting_result!=\"acquired\"}[$__rate_interval]))", "legendFormat": "{{aspnetcore_rate_limiting_result}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10 } } } },
    { "type": "row", "title": "Service counters", "id": 60, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 } },
    { "type": "timeseries", "title": "Logins /s", "id": 61,
      "description": "UserService, slopster_logins_total by result.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (result) (rate(slopster_logins_total[$__rate_interval]))", "legendFormat": "{{result}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } } } },
    { "type": "timeseries", "title": "Games handled by StatisticService (per 5 min)", "id": 62,
      "description": "GameFinished messages StatisticService handled, by result: saved, duplicate (already saved), invalid (rejected) or retry (database failed, requeued). A few games an hour is too little for a per-second rate, so this counts per 5 minutes.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "interval": "5m",
      "targets": [{ "refId": "A", "expr": "sum by (result) (increase(slopster_game_results_total[5m]))", "legendFormat": "{{result}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } } },
    { "type": "timeseries", "title": "Blob storage errors", "id": 64,
      "description": "MusicService calls to Garage (S3 API) that failed, slopster_blob_errors_total by operation.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "quiz-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (operation) (increase(slopster_blob_errors_total[$__rate_interval]))", "legendFormat": "{{operation}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10 } } } },
    { "type": "row", "title": "Traces", "id": 70, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 59 } },
    { "type": "table", "title": "Recent requests (click a trace id to open the trace)", "id": 71,
      "description": "Server spans from Tempo. One game is one trace: the lobby start, every game deadline and GameFinished in StatisticService and LobbyService.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 60 },
      "datasource": { "type": "tempo", "uid": "quiz-tempo" },
      "targets": [{ "refId": "A", "queryType": "traceql", "query": "{ kind = server }", "limit": 20, "tableType": "traces" }] },
    { "type": "row", "title": "Logs", "id": 30, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 70 } },
    { "type": "timeseries", "title": "Log lines by service", "id": 31,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 71 },
      "datasource": { "type": "loki", "uid": "quiz-loki" },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (count_over_time({service_name=~\".+\"}[$__auto]))", "legendFormat": "{{service_name}}" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } } },
    { "type": "logs", "title": "Logs", "id": 32,
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 77 },
      "datasource": { "type": "loki", "uid": "quiz-loki" },
      "targets": [{ "refId": "A", "expr": "{service_name=~\".+\"}" }],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true, "wrapLogMessage": true } }
  ]
}
