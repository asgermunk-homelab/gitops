{
 "uid": "quiz-games",
 "title": "Slopster Games",
 "description": "GameService (SCRUM-119): games being played, games and rounds played, the share of correct answers, and response times per endpoint. Metrics come over OTLP from meter Slopster.Game, and open game connections (SignalR).",
 "tags": [
  "quiz",
  "gameservice"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": false,
 "templating": {
  "list": []
 },
 "links": [
  {
   "title": "Quiz overview",
   "type": "link",
   "url": "/d/quiz-overview",
   "icon": "dashboard"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Games",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Active games",
   "description": "Games being played right now (Status = Playing). The games are in Redis, so every GameService pod reports the same total (max, not sum).",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "max(slopster_games_active)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Games finished (24h)",
   "description": "Games that reached the end screen in the last 24 hours.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(increase(slopster_games_finished_total[24h]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Rounds played (24h)",
   "description": "Rounds that ended (with or without answers) in the last 24 hours.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(increase(slopster_rounds_played_total[24h]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "purple",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Correct answers (24h)",
   "description": "Share of answers that placed the song right, last 24 hours. Rounds without an answer are not counted.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(increase(slopster_answers_total{result=\"correct\"}[24h])) / sum(increase(slopster_answers_total[24h]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Active games",
   "description": "Games being played over time.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "max(slopster_games_active)",
     "legendFormat": "active games"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "fillOpacity": 15,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Games and rounds per minute",
   "description": "Finished games and ended rounds per minute.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(rate(slopster_games_finished_total[$__rate_interval])) * 60",
     "legendFormat": "games / min"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(rate(slopster_rounds_played_total[$__rate_interval])) * 60",
     "legendFormat": "rounds / min"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "fillOpacity": 15,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "row",
   "title": "Endpoints (GameService)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "panels": []
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "p95 response time per endpoint",
   "description": "ASP.NET Core http.server.request.duration for request/response endpoints. The SignalR hub (/hubs/game) is left out: its 'request' is a WebSocket that stays open for the whole game, so its duration is the connection's lifetime (and stops at the histogram's 10 s top bucket). Game connections are in the row below.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 15
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{k8s_deployment_name=\"gameservice\",http_route!~\".*/hubs/.*\"}[$__rate_interval])))",
     "legendFormat": "{{http_route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "fillOpacity": 15,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 13,
   "type": "row",
   "title": "Game connections (SignalR)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 23
   },
   "panels": []
  },
  {
   "id": 14,
   "type": "stat",
   "title": "Open game connections",
   "description": "Players connected to the game hub right now (WebSockets), all GameService pods (signalr.server.active_connections).",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(signalr_server_active_connections{k8s_deployment_name=\"gameservice\"})",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  }
 ]
}
