     },
     "expr": "sum(increase(rabbitmq_global_messages_delivered_total{protocol=\"amqp091\"}[$__range]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
