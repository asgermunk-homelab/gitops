  {
   "id": 14,
   "type": "timeseries",
   "title": "Memory",
   "description": "Resident memory of the RabbitMQ process. The dashed line is the pod's memory limit (512 MiB in gitops infrastructure/rabbitmq.yaml); above it the pod is OOM-killed.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 23
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(rabbitmq_process_resident_memory_bytes)",
     "legendFormat": "resident"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineInterpolation": "smooth",
      "fillOpacity": 15,
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 536870912
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
