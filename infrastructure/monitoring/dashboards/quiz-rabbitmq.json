  {
   "id": 8,
   "type": "timeseries",
   "title": "Messages /min",
   "description": "Published (received by RabbitMQ), routed to a queue, dropped as unroutable, delivered to a consumer, and acked after saving. Published = routed + dropped; delivered ≈ acked when everything is saved.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(rate(rabbitmq_global_messages_received_total{protocol=\"amqp091\"}[$__rate_interval])) * 60",
     "legendFormat": "published"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(rate(rabbitmq_global_messages_routed_total{protocol=\"amqp091\"}[$__rate_interval])) * 60",
     "legendFormat": "routed"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(rate(rabbitmq_global_messages_unroutable_dropped_total{protocol=\"amqp091\"}[$__rate_interval])) * 60",
     "legendFormat": "dropped"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(rate(rabbitmq_global_messages_delivered_total{protocol=\"amqp091\"}[$__rate_interval])) * 60",
     "legendFormat": "delivered"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(rate(rabbitmq_global_messages_acknowledged_total{protocol=\"amqp091\"}[$__rate_interval])) * 60",
     "legendFormat": "acked"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineInterpolation": "smooth",
      "fillOpacity": 15,
      "showPoints": "never"
     },
     "min": 0,
     "decimals": 2
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "dropped"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "acked"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "published"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Messages per queue",
   "description": "Ready (waiting for a consumer) and unacked (delivered, being saved) per queue.",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_ready)",
     "legendFormat": "{{queue}} ready"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_unacked)",
     "legendFormat": "{{queue}} unacked"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineInterpolation": "smooth",
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "min": 0,
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
