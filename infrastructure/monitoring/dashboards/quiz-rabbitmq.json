{
 "uid": "quiz-rabbitmq",
 "title": "Slopster RabbitMQ",
 "description": "RabbitMQ (SCRUM-192): GameFinished messages from GameService to StatisticService - published, dropped because no queue was bound, delivered and acked - plus queue depth, consumers and broker health. Scraped from the rabbitmq_prometheus plugin (port 15692) by a ServiceMonitor in the quiz gitops.",
 "tags": [
  "quiz",
  "rabbitmq"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "editable": false,
 "templating": {
  "list": []
 },
 "links": [
  {
   "title": "Quiz overview",
   "type": "link",
   "url": "/d/quiz-overview",
   "icon": "dashboard"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Game results (GameService → StatisticService)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Published",
   "description": "GameFinished messages GameService published in the selected time range (all exchanges).",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(increase(rabbitmq_global_messages_received_total{protocol=\"amqp091\"}[$__range]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Dropped (unroutable)",
   "description": "Messages no queue was bound for, so RabbitMQ threw them away. Should be 0: anything here is a game result that never reached the statistics (e.g. StatisticService's queue missing).",
   "datasource": {
    "type": "prometheus",
    "uid": "quiz-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "quiz-prometheus"
     },
     "expr": "sum(increase(rabbitmq_global_messages_unroutable_dropped_total{protocol=\"amqp091\"}[$__range]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Delivered to StatisticService",
   "description": "Messages handed to a consumer in the selected time range.",
